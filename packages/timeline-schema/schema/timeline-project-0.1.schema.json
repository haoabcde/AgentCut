{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcut.local/schema/timeline-project-0.1.schema.json",
  "title": "AgentCut Timeline Project 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "assets", "sequences", "styleSpecs", "artifacts", "exportPresets", "versions", "history"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "project": { "$ref": "#/$defs/project" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "sequences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sequence" } },
    "styleSpecs": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "exportPresets": { "type": "array", "items": { "type": "object" } },
    "versions": { "type": "array", "items": { "type": "object" } },
    "history": { "$ref": "#/$defs/history" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "timestamp": { "type": "string", "format": "date-time" },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rate"],
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "rate": { "$ref": "#/$defs/rate" }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "duration"],
      "properties": {
        "start": { "$ref": "#/$defs/time" },
        "duration": { "$ref": "#/$defs/time" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["user", "agent", "workflow"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt", "reason"],
      "properties": {
        "createdBy": { "$ref": "#/$defs/actor" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": "string", "minLength": 1 },
        "sourceArtifactIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt", "updatedAt", "activeSequenceId", "revision"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "activeSequenceId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 0 },
        "defaultStyleSpecId": { "$ref": "#/$defs/id" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "contentHash", "availability", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["video", "audio", "image", "font", "generated"] },
        "uri": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 8 },
        "availability": { "enum": ["online", "offline", "missing"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "metadata": { "type": "object" }
      }
    },
    "transcriptWord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sourceRange", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "normalizedText": { "type": "string", "minLength": 1 },
        "sourceRange": { "$ref": "#/$defs/timeRange" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "speakerId": { "$ref": "#/$defs/id" }
      }
    },
    "deletionTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "wordIds", "sourceRange"],
          "properties": {
            "kind": { "const": "words" },
            "wordIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "sourceRange": { "$ref": "#/$defs/timeRange" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceRange"],
          "properties": {
            "kind": { "const": "gap" },
            "sourceRange": { "$ref": "#/$defs/timeRange" },
            "previousWordId": { "$ref": "#/$defs/id" },
            "nextWordId": { "$ref": "#/$defs/id" }
          },
          "anyOf": [
            { "required": ["previousWordId"] },
            { "required": ["nextWordId"] }
          ]
        }
      ]
    },
    "deletionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "reasonCodes", "decision", "risk", "confidence", "explanationZh"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/deletionTarget" },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["silence", "filler", "stutter", "repetition", "false_start", "restatement", "correction", "incomplete", "manual"]
          }
        },
        "decision": { "enum": ["definite_remove", "suggest_remove", "suggest_keep"] },
        "risk": { "enum": ["low", "medium", "high"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "explanationZh": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "target"],
            "properties": {
              "role": { "const": "retained_comparison" },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "wordIds", "sourceRange"],
                "properties": {
                  "kind": { "const": "words" },
                  "wordIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/id" }
                  },
                  "sourceRange": { "$ref": "#/$defs/timeRange" }
                }
              }
            }
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "target"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "target": { "$ref": "#/$defs/deletionTarget" }
            }
          }
        }
      }
    },
    "transcriptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "assetId", "language", "audioStreamIndex", "words", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "transcript" },
        "assetId": { "$ref": "#/$defs/id" },
        "language": { "type": "string", "minLength": 2 },
        "audioStreamIndex": { "type": "integer", "minimum": 0 },
        "providerArtifactId": { "$ref": "#/$defs/id" },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transcriptWord" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "asrProviderArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "assetId", "audioStreamIndex", "provider", "model", "providerVersion", "payloadHash", "uri", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "asrProviderResult" },
        "assetId": { "$ref": "#/$defs/id" },
        "audioStreamIndex": { "type": "integer", "minimum": 0 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "providerVersion": { "type": "string", "minLength": 1 },
        "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "uri": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "candidateSetArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "transcriptArtifactId", "sequenceId", "clipId", "projectRevision", "detectorVersion", "candidates", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "deletionCandidateSet" },
        "transcriptArtifactId": { "$ref": "#/$defs/id" },
        "sequenceId": { "$ref": "#/$defs/id" },
        "clipId": { "$ref": "#/$defs/id" },
        "projectRevision": { "type": "integer", "minimum": 0 },
        "detectorVersion": { "type": "string", "minLength": 1 },
        "evidenceContracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["retained-comparison-v1"] }
        },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/deletionCandidate" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "editProposalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "candidateSetArtifactId", "projectRevision", "selectedCandidateIds", "estimatedRemovedDuration", "payloadHash", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "editProposal" },
        "candidateSetArtifactId": { "$ref": "#/$defs/id" },
        "projectRevision": { "type": "integer", "minimum": 0 },
        "selectedCandidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "estimatedRemovedDuration": { "$ref": "#/$defs/time" },
        "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "captionCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "wordIds", "timelineRange"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "wordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "timelineRange": { "$ref": "#/$defs/timeRange" }
      }
    },
    "captionDocumentArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "transcriptArtifactId", "sequenceId", "projectRevision", "language", "format", "uri", "contentHash", "cues", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "captionDocument" },
        "transcriptArtifactId": { "$ref": "#/$defs/id" },
        "sequenceId": { "$ref": "#/$defs/id" },
        "projectRevision": { "type": "integer", "minimum": 0 },
        "language": { "type": "string", "minLength": 1 },
        "format": { "const": "srt" },
        "uri": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "cues": { "type": "array", "items": { "$ref": "#/$defs/captionCue" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "renderQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timelineDuration", "outputDuration", "durationDeltaMillis", "width", "height", "hasAudio", "subtitleCueCount", "passed"],
      "properties": {
        "timelineDuration": { "$ref": "#/$defs/time" },
        "outputDuration": { "$ref": "#/$defs/time" },
        "expectedOutputMicros": { "type": "integer", "minimum": 0 },
        "durationDeltaMillis": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "hasAudio": { "type": "boolean" },
        "subtitleCueCount": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" },
        "fitMode": { "enum": ["contain", "cover"] },
        "fitModeApproximate": { "type": "boolean" },
        "colorApproximate": { "type": "boolean" }
      }
    },
    "renderReportArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sequenceId", "projectRevision", "outputAssetId", "renderer", "rendererVersion", "planHash", "duration", "fileSizeBytes", "videoCodec", "audioCodec", "quality", "warnings", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "renderReport" },
        "sequenceId": { "$ref": "#/$defs/id" },
        "projectRevision": { "type": "integer", "minimum": 0 },
        "outputAssetId": { "$ref": "#/$defs/id" },
        "captionArtifactId": { "$ref": "#/$defs/id" },
        "renderer": { "const": "ffmpeg" },
        "rendererVersion": { "type": "string", "minLength": 1 },
        "planHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "duration": { "$ref": "#/$defs/time" },
        "fileSizeBytes": { "type": "integer", "minimum": 1 },
        "videoCodec": { "type": "string", "minLength": 1 },
        "audioCodec": { "type": "string", "minLength": 1 },
        "quality": { "$ref": "#/$defs/renderQuality" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "artifact": {
      "oneOf": [
        { "$ref": "#/$defs/asrProviderArtifact" },
        { "$ref": "#/$defs/transcriptArtifact" },
        { "$ref": "#/$defs/candidateSetArtifact" },
        { "$ref": "#/$defs/editProposalArtifact" },
        { "$ref": "#/$defs/captionDocumentArtifact" },
        { "$ref": "#/$defs/renderReportArtifact" }
      ]
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "timelineRange", "enabled", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["media", "caption", "text", "image", "sticker", "shape", "nestedSequence", "gap"] },
        "assetId": { "$ref": "#/$defs/id" },
        "sequenceId": { "$ref": "#/$defs/id" },
        "streamIndex": { "type": "integer", "minimum": 0 },
        "timelineRange": { "$ref": "#/$defs/timeRange" },
        "sourceRange": { "$ref": "#/$defs/timeRange" },
        "enabled": { "type": "boolean" },
        "transform": { "type": "object" },
        "audio": { "type": "object" },
        "content": { "type": "object" },
        "animations": { "type": "array", "items": { "type": "object" } },
        "effects": { "type": "array", "items": { "type": "object" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "metadata": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "media" } }, "required": ["kind"] },
          "then": { "required": ["assetId", "sourceRange"] }
        },
        {
          "if": { "properties": { "kind": { "const": "nestedSequence" } }, "required": ["kind"] },
          "then": { "required": ["sequenceId"] }
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "order", "locked", "enabled", "clips", "transitions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["video", "audio", "caption", "graphic"] },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "locked": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } },
        "transitions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "mode", "scope", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "owner": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["deny_agent", "owner_only"] },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "note": { "type": "string" },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "clipId"],
              "properties": { "kind": { "const": "clip" }, "clipId": { "$ref": "#/$defs/id" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "trackId"],
              "properties": { "kind": { "const": "track" }, "trackId": { "$ref": "#/$defs/id" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "range"],
              "properties": {
                "kind": { "const": "range" },
                "range": { "$ref": "#/$defs/timeRange" },
                "trackIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "assetId", "range"],
              "properties": {
                "kind": { "const": "source_range" },
                "assetId": { "$ref": "#/$defs/id" },
                "range": { "$ref": "#/$defs/timeRange" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "objectId", "path"],
              "properties": {
                "kind": { "const": "property" },
                "objectId": { "$ref": "#/$defs/id" },
                "path": { "type": "string", "pattern": "^/" }
              }
            }
          ]
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "canvas", "frameRate", "tracks", "locks", "markers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "background"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "background": { "type": "string", "minLength": 1 },
            "pixelAspect": { "$ref": "#/$defs/rate" }
          }
        },
        "frameRate": { "$ref": "#/$defs/rate" },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "locks": { "type": "array", "items": { "$ref": "#/$defs/lock" } },
        "markers": { "type": "array", "items": { "type": "object" } },
        "styleSpecId": { "$ref": "#/$defs/id" },
        "exportPresetId": { "$ref": "#/$defs/id" }
      }
    },
    "historyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transactionId", "baseRevision", "committedRevision", "actor", "reason", "beforeHash", "afterHash", "committedAt"],
      "properties": {
        "transactionId": { "$ref": "#/$defs/id" },
        "baseRevision": { "type": "integer", "minimum": 0 },
        "committedRevision": { "type": "integer", "minimum": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "beforeHash": { "type": "string", "minLength": 8 },
        "afterHash": { "type": "string", "minLength": 8 },
        "committedAt": { "$ref": "#/$defs/timestamp" },
        "commandUri": { "type": "string", "minLength": 1 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headRevision", "records"],
      "properties": {
        "headRevision": { "type": "integer", "minimum": 0 },
        "records": { "type": "array", "items": { "$ref": "#/$defs/historyRecord" } }
      }
    }
  }
}
