{
  "name": "agentcut",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-native video editor technical validation workspace",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "agent": "node scripts/agentcut-agent.mjs",
    "mcp": "node scripts/agentcut-mcp.mjs",
    "alpha:audit": "pnpm --filter @agentcut/alpha-gate build && node scripts/alpha-audit.mjs",
    "alpha:evidence": "pnpm --filter @agentcut/alpha-gate build && node scripts/alpha-evidence.mjs",
    "alpha:gate": "pnpm --filter @agentcut/alpha-gate build && node scripts/alpha-gate.mjs",
    "alpha:verify": "pnpm --filter @agentcut/alpha-gate build && node scripts/alpha-correctness.mjs",
    "alpha:collect": "pnpm --filter @agentcut/alpha-gate build && node scripts/alpha-collect.mjs",
    "roughcut": "pnpm build && node scripts/roughcut.mjs",
    "studio": "node scripts/start-studio.mjs",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm build && pnpm -r test",
    "check": "pnpm build && pnpm -r typecheck && pnpm -r test",
    "alpha:new-sample": "node scripts/new-alpha-sample.mjs",
    "e2e:agent": "node scripts/agent-e2e.mjs",
    "quickstart": "node scripts/quickstart.mjs",
    "quickstart:verify": "node scripts/verify-quickstart.mjs",
    "demo:shorts": "node demos/short-video-generator/scripts/run-demo.mjs --synthetic",
    "demo:shorts:custom": "node demos/short-video-generator/scripts/run-demo.mjs",
    "demo:shorts:web": "node demos/short-video-generator/scripts/serve.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "26.1.1",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
